# Copy to .env.integration in the repository root. Do not add shell quotes.
INFORMIX_INTEGRATION=1
# Verified with --network=host on the same Linux host as Informix.
# Use another reachable address for a different container network layout.
INFORMIX_HOST=127.0.0.1
INFORMIX_SERVICE=9088
# Server is INFORMIXSERVER, not the container name.
INFORMIX_SERVER=informix
INFORMIX_DATABASE=laravel_ifx_test
INFORMIX_USERNAME=informix
INFORMIX_PASSWORD=REPLACE_LOCALLY
INFORMIX_PROTOCOL=onsoctcp
# Verified laravel_ifx_test locale. Query sysmaster:sysdbslocale for other databases.
INFORMIX_DB_LOCALE=en_US.819
INFORMIX_CLIENT_LOCALE=en_US.819
