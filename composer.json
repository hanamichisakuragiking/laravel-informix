{
    "name": "hanamichisakuragiking/laravel-informix",
    "description": "IBM Informix database driver for Laravel 11, 12, and 13",
    "keywords": ["laravel", "informix", "database", "pdo"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jason",
            "email": "jason@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.35|^11.5.50|^12.5.8|^13.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hanamichisakuragiking\\LaravelInformix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanamichisakuragiking\\LaravelInformix\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hanamichisakuragiking\\LaravelInformix\\InformixServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group integration",
        "test:integration": "phpunit --group integration --fail-on-skipped --do-not-cache-result"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
